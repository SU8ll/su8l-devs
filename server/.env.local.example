# ── Local Development Environment ──────────────────────────────────────────────
# Copy this file to server/.env.local (it's git-ignored) and fill in values.
# Run: docker compose up postgres -d   (starts local PostgreSQL)
# Run: npm run dev:local               (starts server + web with local config)

PORT=4000
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
JWT_SECRET=local-dev-secret-change-me-in-production
DATABASE_URL=postgres://postgres:postgres@localhost:5432/su8l_dev
CORS_ORIGINS=

# ── Discord OAuth2 (create a new app at https://discord.com/developers/applications) ──
# Redirect URI: http://localhost:4000/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ── Google OAuth2 (create at https://console.cloud.google.com/apis/credentials) ──
# Redirect URI: http://localhost:4000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Facebook OAuth2 (create at https://developers.facebook.com/apps) ──
# Redirect URI: http://localhost:4000/api/auth/facebook/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ── PayPal Sandbox (use sandbox credentials) ──
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=

# ── Optional ──
OWNER_WHATSAPP=
OWNER_DISCORD_ID=
BOT_API_KEY=local-bot-secret
BOT_CALLBACK_URL=
STAFF_DISCORD_IDS=
UPTIME_TARGET_URL=
UPTIME_INTERVAL_MS=60000

# ── Admin Panel Key ──
ADMIN_API_KEY=admin-dev-key
