# ── SU8L DEVs Server Environment ─────────────────────────────────────────────
PORT=4000
# Public origin of the frontend app (OAuth redirect + CORS + PayPal return urls)
# PRODUCTION: https://su8ldevs.eu.cc
APP_URL=http://localhost:5173
# Public origin of this API (used for OAuth redirect URIs)
# PRODUCTION: https://your-api.onrender.com
API_URL=http://localhost:4000
# 32+ char secret used to sign session JWTs — CHANGE IT
JWT_SECRET=change-me-to-a-long-random-secret
# Postgres connection string (Supabase / Neon / local)
# PRODUCTION: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/su8l
# Comma-separated extra origins allowed by CORS (the Vercel frontend)
# PRODUCTION: https://su8ldevs.eu.cc,https://su8ldevs.eu.cc
CORS_ORIGINS=

# ── Discord OAuth2 ────────────────────────────────────────────────────────────
# PRODUCTION redirect URI: https://your-api.onrender.com/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ── Google OAuth2 (fallback login — optional) ────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Facebook OAuth2 (fallback login — optional) ──────────────────────────────
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ── PayPal REST API ──────────────────────────────────────────────────────────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox | live
PAYPAL_MODE=sandbox
# The Webhook ID shown in your PayPal app's "Webhooks" tab. When set, inbound
# webhook signatures are cryptographically verified. Leave empty to skip (dev).
# PRODUCTION webhook URL: https://your-api.onrender.com/api/webhooks/paypal
PAYPAL_WEBHOOK_ID=

# ── Brand / Owner ────────────────────────────────────────────────────────────
# Owner WhatsApp number in international format WITHOUT '+' or spaces, e.g. 15551234567
OWNER_WHATSAPP=
# Discord ID of the owner (used by the /su8l_promo bot command server-side guard)
OWNER_DISCORD_ID=
# Shared secret between the Discord bot and this API for promo code generation
BOT_API_KEY=change-me-to-a-long-random-bot-secret
# Base URL of the Discord bot's HTTP callback — the API dispatches Cloud
# Configurator DMs + role grants here (e.g. http://localhost:4001)
BOT_CALLBACK_URL=
# Comma separated Discord IDs allowed to answer support tickets as staff
STAFF_DISCORD_IDS=

# ── Uptime Status Monitor ────────────────────────────────────────────────────
# URL the uptime checker pings (your bot service public endpoint)
UPTIME_TARGET_URL=https://example.eu.cc
UPTIME_INTERVAL_MS=60000
