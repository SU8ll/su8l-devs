# ── SU8L DEVs Discord Bot ────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=
# Discord ID of the owner. ONLY this user can run /su8l_promo, and Cloud
# Configurator settings get DM'd to this Discord ID.
OWNER_DISCORD_ID=
# Guild(s) to register slash commands in (comma separated). Empty = global.
GUILD_IDS=
# The same secret configured on the server (BOT_API_KEY) — auths this bot to the API.
BOT_API_KEY=change-me-to-a-long-random-bot-secret
# The SU8L API base URL
API_URL=http://localhost:4000
# Port for the HTTP callback that receives config DMs + role grants from the API
# (must match server BOT_CALLBACK_URL). Default 4001.
BOT_PORT=4001
# Discord role ID granted to customers after a successful payment.
PAID_ROLE_ID=
